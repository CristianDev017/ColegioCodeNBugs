<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="HistorialPagos"
              pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="TITULO" class="java.lang.String"/>
    <parameter name="FILTROS" class="java.lang.String"/>
    <parameter name="GENERADO" class="java.lang.String"/>
    <parameter name="ESTUDIANTE" class="java.lang.String"/>
    <parameter name="CARNET" class="java.lang.String"/>
    <parameter name="TOTAL_PAGADO" class="java.math.BigDecimal"/>
    <parameter name="SALDO_PENDIENTE" class="java.math.BigDecimal"/>

    <field name="idPago" class="java.lang.Integer"/>
    <field name="carnet" class="java.lang.String"/>
    <field name="estudiante" class="java.lang.String"/>
    <field name="anio" class="java.lang.Integer"/>
    <field name="concepto" class="java.lang.String"/>
    <field name="detalle" class="java.lang.String"/>
    <field name="fechaPago" class="java.lang.String"/>
    <field name="monto" class="java.math.BigDecimal"/>
    <field name="comprobante" class="java.lang.String"/>

    <title>
        <band height="95">
            <textField>
                <reportElement uuid="c1000001-1111-4111-8111-111111111111"
                               x="0" y="5" width="555" height="28"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TITULO}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement uuid="c1000002-1111-4111-8111-111111111111"
                               x="0" y="35" width="555" height="16"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Estudiante: " + $P{ESTUDIANTE} + "   Carnet: " + $P{CARNET}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement uuid="c1000003-1111-4111-8111-111111111111"
                               x="0" y="55" width="555" height="14"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{FILTROS}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement uuid="c1000004-1111-4111-8111-111111111111"
                               x="0" y="72" width="555" height="14"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Generado: " + $P{GENERADO}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="26">
            <staticText>
                <reportElement uuid="c1000005-1111-4111-8111-111111111111"
                               x="0" y="0" width="75" height="20"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Fecha]]></text>
            </staticText>

            <staticText>
                <reportElement uuid="c1000006-1111-4111-8111-111111111111"
                               x="75" y="0" width="45" height="20"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Año]]></text>
            </staticText>

            <staticText>
                <reportElement uuid="c1000007-1111-4111-8111-111111111111"
                               x="120" y="0" width="100" height="20"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Concepto]]></text>
            </staticText>

            <staticText>
                <reportElement uuid="c1000008-1111-4111-8111-111111111111"
                               x="220" y="0" width="125" height="20"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Detalle]]></text>
            </staticText>

            <staticText>
                <reportElement uuid="c1000009-1111-4111-8111-111111111111"
                               x="345" y="0" width="110" height="20"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Comprobante]]></text>
            </staticText>

            <staticText>
                <reportElement uuid="c1000010-1111-4111-8111-111111111111"
                               x="455" y="0" width="100" height="20"/>
                <textElement textAlignment="Right">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Monto]]></text>
            </staticText>

            <line>
                <reportElement uuid="c1000011-1111-4111-8111-111111111111"
                               x="0" y="23" width="555" height="1"/>
            </line>
        </band>
    </columnHeader>

    <detail>
        <band height="22">
            <textField isBlankWhenNull="true">
                <reportElement uuid="c1000012-1111-4111-8111-111111111111"
                               x="0" y="0" width="75" height="20"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{fechaPago}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement uuid="c1000013-1111-4111-8111-111111111111"
                               x="75" y="0" width="45" height="20"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{anio}]]></textFieldExpression>
            </textField>

            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement uuid="c1000014-1111-4111-8111-111111111111"
                               x="120" y="0" width="100" height="20"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{concepto}]]></textFieldExpression>
            </textField>

            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement uuid="c1000015-1111-4111-8111-111111111111"
                               x="220" y="0" width="125" height="20"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{detalle}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement uuid="c1000016-1111-4111-8111-111111111111"
                               x="345" y="0" width="110" height="20"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{comprobante}]]></textFieldExpression>
            </textField>

            <textField pattern="Q #,##0.00">
                <reportElement uuid="c1000017-1111-4111-8111-111111111111"
                               x="455" y="0" width="100" height="20"/>
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{monto}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement uuid="c1000023-1111-4111-8111-111111111111"
                               x="0" y="2" width="555" height="16"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="65">
            <line>
                <reportElement uuid="c1000018-1111-4111-8111-111111111111"
                               x="0" y="5" width="555" height="1"/>
            </line>

            <staticText>
                <reportElement uuid="c1000019-1111-4111-8111-111111111111"
                               x="310" y="12" width="145" height="20"/>
                <textElement textAlignment="Right">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Total pagado:]]></text>
            </staticText>

            <textField pattern="Q #,##0.00">
                <reportElement uuid="c1000020-1111-4111-8111-111111111111"
                               x="455" y="12" width="100" height="20"/>
                <textElement textAlignment="Right">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_PAGADO}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement uuid="c1000021-1111-4111-8111-111111111111"
                               x="310" y="35" width="145" height="20"/>
                <textElement textAlignment="Right">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Saldo pendiente:]]></text>
            </staticText>

            <textField pattern="Q #,##0.00">
                <reportElement uuid="c1000022-1111-4111-8111-111111111111"
                               x="455" y="35" width="100" height="20"/>
                <textElement textAlignment="Right">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SALDO_PENDIENTE}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
